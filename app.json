{
  "expo": {
    "name": "Daily Dose",
    "slug": "daily-dose",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dailydose",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dailydose.app"
    },
    "android": {
      "package": "com.dailydose.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
